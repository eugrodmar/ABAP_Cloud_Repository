managed implementation in class ZBP_R_PROF_17 unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_PROF_17 alias ZrProf17
persistent table ZPROF_17
extensible
draft table ZPROF_17_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( mandatory : create )
   ID;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt;

  field ( readonly : update )
   ID;


  create;
  update;
  delete;

  action subida_sueldo result [1] $self;
  action modificar_empleo result [1] $self;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZPROF_17 corresponding extensible
  {
    ID = ID;
    Nombre = NOMBRE;
    Profesion = PROFESION;
    Salario = SALARIO;
    IsActive = IS_ACTIVE;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LastChangedAt = LAST_CHANGED_AT;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
  }

}